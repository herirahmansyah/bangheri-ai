  <script src="scrollcraft.js"></script>
  <script>
    if (window.ScrollCraft && typeof ScrollCraft.mount === 'function') { ScrollCraft.mount(document.body); }
    (function () {
      var rail = document.querySelectorAll('.bh-rail__node');
      if (!rail.length) return;
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          rail.forEach(function (n) { n.classList.toggle('is-active', n.dataset.target === e.target.id); });
        });
      }, { rootMargin: '-45% 0px -50% 0px' });
      ['identity','thesis','featured','collection','proof','contact'].forEach(function (id) {
        var el = document.getElementById(id); if (el) io.observe(el);
      });
    })();
    (function () {
      var pct = document.querySelector('[data-sc-hud-pct]');
      var bar = document.querySelector('[data-sc-progress]');
      function update() {
        var max = document.documentElement.scrollHeight - window.innerHeight;
        var p = max > 0 ? Math.min(Math.max(window.scrollY / max, 0), 1) : 0;
        if (pct) pct.textContent = String(Math.round(p * 100)).padStart(2, '0');
        if (bar) bar.style.width = (p * 100) + '%';
      }
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
      update();
    })();
    document.querySelectorAll('a[href^="#"]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        var id = a.getAttribute('href').slice(1);
        var el = document.getElementById(id);
        if (!el) return;
        e.preventDefault();
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  </script>
</body>
</html>
